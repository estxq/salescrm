# Copy to .env and fill in when you're ready to go live.
# The app runs fine with none of these set — meetings need a manual Zoom
# link, emails are logged instead of sent, and leads fall back to
# data/leads.sample.json instead of a real Google Sheet.

PORT=3000

# Public URL this server is reachable at — used to build calendar (.ics)
# links and the Zoom OAuth redirect. Only matters once you're not testing
# on localhost.
BASE_URL=http://localhost:3000

# Minutes before a meeting to raise an in-app reminder notification.
REMINDER_WINDOW_MIN=60

# --- Zoom (create meetings on the agent's own personal Zoom account) ---
# 1. Go to marketplace.zoom.us > Develop > Build App > "General App" (OAuth).
# 2. Redirect URL for OAuth must exactly match ZOOM_REDIRECT_URI below.
# 3. Scopes needed: meeting:write:meeting, meeting:update:meeting,
#    meeting:delete:meeting, user:read:user (Zoom's newer granular scopes —
#    use the meeting:write / meeting:read / user:read classic scopes if
#    your account still shows those instead).
# 4. Copy the Client ID + Client Secret below, then open /auth/zoom in the
#    app and sign in with the agent's own Zoom account to connect it.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3000/auth/zoom/callback

# --- Outbound email (templates + open tracking) ---
# Any SMTP account works (Gmail app password, SendGrid, Postmark, etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=sales@example.com

# --- Google Sheets (leads list) ---
# Simplest path: make the sheet "Anyone with the link can view", enable
# the Sheets API on a Google Cloud project, and create an API key.
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Leads!A2:D
