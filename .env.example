# Copy to .env and fill in when you're ready to go live.
# The app runs fine with none of these set — meetings need a manual Zoom
# link and leads fall back to data/leads.sample.json instead of a real
# Google Sheet.

PORT=3000

# Public URL this server is reachable at — used to build calendar (.ics)
# links and the Zoom OAuth redirect. Only matters once you're not testing
# on localhost.
BASE_URL=http://localhost:3000

# Minutes before a meeting to raise an in-app reminder notification.
REMINDER_WINDOW_MIN=60

# Secret used to sign login cookies. Optional: if you leave it out, one is
# generated on first use and stored alongside the data. Set it if you want to
# be able to rotate it (changing it logs everyone out).
SESSION_SECRET=

# --- Persistence on Vercel ---
# Locally this app just uses JSON files in data/ — nothing to set here.
# On Vercel, connect a Redis store (Storage tab -> Marketplace -> Upstash)
# to the project; Vercel injects UPSTASH_REDIS_REST_URL / _TOKEN
# automatically and the app switches to it on its own. Nothing to add here
# manually, this is just documenting where those env vars come from.

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" when it
# calls /api/cron/reminders, so randoms can't trigger it. Only matters on
# Vercel; generate any random string.
CRON_SECRET=

# --- Zoom (create meetings on the agent's own personal Zoom account) ---
# 1. Go to marketplace.zoom.us > Develop > Build App > "General App" (OAuth).
# 2. Redirect URL for OAuth must exactly match ZOOM_REDIRECT_URI below.
# 3. Scopes needed: meeting:write:meeting, meeting:update:meeting,
#    meeting:delete:meeting, user:read:user (Zoom's newer granular scopes —
#    use the meeting:write / meeting:read / user:read classic scopes if
#    your account still shows those instead).
# 4. Copy the Client ID + Client Secret below, then open /auth/zoom in the
#    app and sign in with the agent's own Zoom account to connect it.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3000/auth/zoom/callback
# Optional: more Zoom apps side by side (up to _5). A Zoom app that isn't published only lets
# in accounts belonging to its owner's Zoom account, so different teams may need different
# apps; the Agent picks one in the Zoom menu. Labels are what the picker shows.
# ZOOM_APP_LABEL=Shared app
# ZOOM_CLIENT_ID_2=
# ZOOM_CLIENT_SECRET_2=
# ZOOM_APP_LABEL_2=Second app
# A team can also save its own Zoom app's Client ID/Secret inside the app ("Own Zoom app"
# beside Connect Zoom) — no limit on teams, no redeploy. The Secret is stored encrypted;
# set this key so it isn't protected only by a secret sitting in the same database:
# ZOOM_CRED_KEY=<long random string — keep it stable; changing it means teams must re-enter their Secret>

# --- Google Calendar (show the agent's calendar next to their Zoom meetings) ---
# Read-only. The agent connects their own Google account once ("Share Google
# Calendar with Caller" in the top bar — only the calendar's owner can give that
# permission). The events then show on the CALLER's Summary calendar only; the
# agent's own calendar stays a clean calendar of Zoom meetings.
# 1. console.cloud.google.com > new project > APIs & Services > Library >
#    enable "Google Calendar API".
# 2. OAuth consent screen: choose "Internal" if the agent's Google account is a
#    Google Workspace one in your organisation (no review needed, tokens don't
#    expire). Otherwise "External" in Testing mode and add the agent's Gmail as
#    a test user (Google then expires the login every 7 days: reconnect weekly,
#    or publish the app to stop that).
# 3. Credentials > Create credentials > OAuth client ID > Web application. Add
#    this exact Authorized redirect URI: the value of GOOGLE_REDIRECT_URI below.
# 4. Copy the client ID/secret here (on Vercel: Project Settings > Environment
#    Variables), then redeploy. These are separate from the Sheets key below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Google Sheets (leads list) ---
# Simplest path: make the sheet "Anyone with the link can view", enable
# the Sheets API on a Google Cloud project, and create an API key.
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Leads!A2:D
